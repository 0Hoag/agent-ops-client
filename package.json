{
  "name": "agent-ops-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "RSPACK_MODE=local rspack serve",
    "start": "pnpm dev",
    "build": "pnpm typecheck && NODE_ENV=production RSPACK_MODE=production rspack build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "verify:env": "node scripts/verify-env-fixture.mjs",
    "verify:servers": "node scripts/verify-servers.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:runs-browser": "node scripts/verify-runs-browser.mjs",
    "verify:insights-browser": "node scripts/verify-insights-browser.mjs",
    "generate:api": "swagger-typescript-api generate -p src/shared/api/swagger.json -o src/shared/api/generated -n Api.ts --axios --sort-routes --sort-types --templates scripts/api-templates --single-http-client",
    "preview": "NODE_ENV=production RSPACK_MODE=production rspack preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@rspack/cli": "^1.0.5",
    "@rspack/core": "^1.0.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.2.1",
    "swagger-typescript-api": "13.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.5"
  }
}
