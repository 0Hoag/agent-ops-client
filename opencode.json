{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "doom_loop": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/agent-ops-client/**": "allow",
      "~/agent-ops-wt/**": "allow",
      "~/.codex/skills/**": "allow",
      "~/.ssh/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.codex/worker.config.toml": "allow",
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/Library/Caches/pnpm/**": "allow",
      "~/Library/pnpm/**": "allow",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    }
  },
  "tool_output": {
    "max_lines": 250,
    "max_bytes": 16384
  }
}
